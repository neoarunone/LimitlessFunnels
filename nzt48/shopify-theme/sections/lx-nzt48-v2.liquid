tColor" strokeWidth="1.6" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><path d="M14 2v6a2 2 0 0 0 .245.96l5.51 10.08A2 2 0 0 1 18 22H6a2 2 0 0 1-1.755-2.96l5.51-10.08A2 2 0 0 0 10 8V2"/><path d="M6.453 15h11.094"/><path d="M8.5 2h7"/></svg><span>{{ copy.trust.1 }}</span></div><div class="tm-item" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></svg><span>{{ copy.trust.2 }}</span></div><div class="tm-item" aria-hidden="true"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="1.6" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18H9"/><path d="M19 18h2a1 1 0 0 0 1-1v-3.65a1 1 0 0 0-.22-.624l-3.48-4.35A1 1 0 0 0 17.52 8H14"/><circle cx="17" cy="18" r="2"/><circle cx="7" cy="18" r="2"/></svg><span>{{ copy.trust.3 }}</span></div></div></div>
  </section>

  <!-- BENEFITS: photo tiles, blue wash on hover -->
  <section data-screen-label="Benefits" class="sec">
    <div class="wrap" style="display:flex;flex-direction:column;align-items:center;gap:var(--s5)">
      <div style="display:flex;flex-direction:column;align-items:center;gap:var(--s2);text-align:center;max-width:620px">
        <span class="lab">{{ copy.benefits.eyebrow }}</span>
        <h2 class="serif d2">{{ it.benefits.a }}<em>{{ it.benefits.b }}</em></h2>
        <p class="p">{{ copy.benefits.lede }}</p>
      </div>
      <div style="width:100%;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:var(--s4) var(--s3)">
        <sc-for list="{{ benefits }}" as="b" hint-placeholder-count="4">
          <div class="bcard" style="display:flex;flex-direction:column;gap:var(--s3)">
            <div class="btile"><img src="{{ b.image }}" alt="" loading="lazy"></div>
            <div style="display:flex;flex-direction:column;gap:var(--s1)">
              <h3 class="serif d3" style="font-size:26px;color:var(--ink)">{{ b.t }}</h3>
              <p class="p" style="font-size:14px">{{ b.d }}</p>
            </div>
          </div>
        </sc-for>
      </div>
    </div>
  </section>

  <!-- ONE CAPSULE: centred stack -->
  <section data-screen-label="Nootropics + One Capsule" style="background:var(--blue);color:var(--paper)">
    <div class="wrap sec" style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:var(--s4)">
      <img src="lx-nzt-photos-pill-standing.webp?v=a31a0a3509" alt="One gold NZT48 capsule standing upright" loading="lazy" style="display:block;width:150px;height:auto;filter:drop-shadow(0 26px 30px rgba(0,0,0,.45))">
      <span class="lab" style="color:#E7CF86">{{ copy.oneCapsule.eyebrow }}</span>
      <h2 class="serif d2" style="color:var(--paper);max-width:16ch">{{ it.oneCapsule.a }}<em>{{ it.oneCapsule.b }}</em></h2>
      <div style="display:flex;flex-direction:column;gap:var(--s2);max-width:62ch">
        <p class="p" style="color:#DADEEC">{{ copy.oneCapsule.p1 }}</p>
        <p class="p" style="color:#DADEEC">{{ copy.oneCapsule.p2 }}</p>
      </div>
      <dl style="margin:0;width:100%;max-width:760px;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,150px),1fr));border-top:1px solid rgba(218,222,236,.24)">
        <sc-for list="{{ copy.oneCapsule.stats }}" as="st" hint-placeholder-count="4">
          <div style="display:flex;flex-direction:column;gap:6px;padding:var(--s3) var(--s2);border-bottom:1px solid rgba(218,222,236,.24)"><dt class="lab" style="color:#DADEEC">{{ st.0 }}</dt><dd class="serif" style="margin:0;font-size:26px;line-height:1.1;color:var(--paper)">{{ st.1 }}</dd></div>
        </sc-for>
      </dl>
    </div>
  </section>

  <!-- INGREDIENTS: index -->
  <section id="formula" data-screen-label="Ingredients" class="sec" style="scroll-margin-top:68px">
    <div class="wrap gold-r gold" style="align-items:start">
      <div class="stick" style="display:flex;flex-direction:column;gap:var(--s2)">
        <span class="lab">{{ copy.ingredients.eyebrow }}</span>
        <h2 class="serif d2">{{ it.ingredients.a }}<em>{{ it.ingredients.b }}</em></h2>
        <p class="p" style="font-size:14.5px">{{ copy.ingredients.lede }}</p>
        <img src="lx-nzt-photos-pill-side.webp?v=6f55a299d9" alt="A single gold NZT48 capsule" loading="lazy" style="display:block;width:100%;aspect-ratio:2/1;object-fit:cover;border-radius:3px;margin-top:var(--s2)">
      </div>
      <div style="display:flex;flex-direction:column;gap:var(--s3)">
        <div style="border-top:1px solid var(--ink)">
          <sc-for list="{{ ingredients }}" as="g" hint-placeholder-count="8">
            <details class="acc">
              <summary>
                <img class="ing-photo" src="{{ g.image }}" alt="" width="96" height="96" loading="lazy" decoding="async">
                <span style="display:flex;flex-direction:column;gap:6px;min-width:0"><span class="serif" style="font-size:26px;line-height:1.1;color:var(--ink)">{{ g.name }}</span><span style="font:400 13px/1.4 Inter,sans-serif;color:var(--mute)">{{ g.what }}</span></span>
                <span class="pm" aria-hidden="true">+</span>
              </summary>
              <div class="ing-research">
                <div style="display:flex;flex-direction:column;gap:6px"><span class="lab">{{ copy.ingredients.researchLabel }}</span><p class="p" style="font-size:14px">{{ g.research }}</p></div>
                <div style="display:flex;flex-direction:column;gap:6px"><span class="lab" style="color:var(--blue)">{{ copy.ingredients.sayLabel }}</span><p class="p" style="font-size:14px;color:var(--ink)">{{ g.say }}</p></div>
              </div>
            </details>
          </sc-for>
        </div>
        <p class="sm"><span style="color:var(--ink);font-weight:600">{{ copy.ingredients.alsoLabel }}</span> {{ alsoIn }} {{ copy.ingredients.foot }} Ingredient photos are illustrative.</p>
      </div>
    </div>
  </section>

  <!-- ROUTINE -->
  <section data-screen-label="Daily Routine" class="sec rule">
    <div class="wrap" style="display:flex;flex-direction:column;gap:var(--s5)">
      <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:end;gap:var(--s3)">
        <h2 class="serif d2">{{ it.routine.a }}<em>{{ it.routine.b }}</em></h2>
        <span class="lab">{{ copy.routine.eyebrow }}</span>
      </div>
      <ol style="margin:0;padding:0;list-style:none;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:var(--s4)">
        <li style="display:flex;flex-direction:column;gap:var(--s2)">
          <img src="lx-nzt-photos-pill-shadow.webp?v=05e52184c4" alt="Taking one NZT48 Original capsule in the morning" loading="lazy" style="display:block;width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:3px">
          <span class="serif it" style="font-size:22px;color:var(--blue)">Step 1</span>
          <h3 style="margin:0;font:600 16px/1.4 Inter,sans-serif">{{ copy.routine.steps.0.0 }}</h3>
          <p class="p" style="font-size:14px">{{ copy.routine.steps.0.1 }}</p>
        </li>
        <li style="display:flex;flex-direction:column;gap:var(--s2)">
          <img src="lx-nzt-photos-step-2.webp?v=d136aee178" alt="NZT48 Original beside a glass of water in the kitchen" loading="lazy" style="display:block;width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:3px">
          <span class="serif it" style="font-size:22px;color:var(--blue)">Step 2</span>
          <h3 style="margin:0;font:600 16px/1.4 Inter,sans-serif">{{ copy.routine.steps.1.0 }}</h3>
          <p class="p" style="font-size:14px">{{ copy.routine.steps.1.1 }}</p>
        </li>
        <li style="display:flex;flex-direction:column;gap:var(--s2)">
          <img src="lx-nzt-photos-step-3.webp?v=d27e245301" alt="Getting ready in the morning with NZT48 Original" loading="lazy" style="display:block;width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:3px">
          <span class="serif it" style="font-size:22px;color:var(--blue)">Step 3</span>
          <h3 style="margin:0;font:600 16px/1.4 Inter,sans-serif">{{ copy.routine.steps.2.0 }}</h3>
          <p class="p" style="font-size:14px">{{ copy.routine.steps.2.1 }}</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- WHO IT FITS: case-study row -->
  <section data-screen-label="Who It Fits" class="sec" style="background:var(--tint)">
    <div class="wrap" style="display:flex;flex-direction:column;gap:var(--s4)">
      <div class="gold" style="align-items:end;gap:var(--s2) var(--s5)">
        <div style="display:flex;flex-direction:column;gap:var(--s2)"><span class="lab">{{ copy.uses.eyebrow }}</span><h2 class="serif d2">{{ it.uses.a }}<em>{{ it.uses.b }}</em></h2></div>
        <p class="p" style="font-size:14.5px">{{ copy.uses.foot }}</p>
      </div>
      <div class="row">
        <sc-for list="{{ scenarios }}" as="u" hint-placeholder-count="8">
          <article class="scard" style="flex:0 0 min(78vw,290px);scroll-snap-align:start;display:flex;flex-direction:column;gap:var(--s2)">
            <img src="{{ u.image }}" alt="" loading="lazy">
            <span class="lab" style="color:var(--blue)">{{ u.who }}</span>
            <h3 class="serif" style="margin:0;font-size:26px;line-height:1.12;color:var(--ink)">{{ u.t }}</h3>
            <p class="p" style="font-size:14px">{{ u.d }}</p>
          </article>
        </sc-for>
      </div>
    </div>
  </section>

  <!-- COMPARISON: side-by-side capsule count -->
  <section data-screen-label="Comparison" class="sec">
    <div class="wrap" style="display:flex;flex-direction:column;gap:var(--s5)">
      <div style="display:flex;flex-direction:column;align-items:center;text-align:center;gap:var(--s2);max-width:640px;margin:0 auto">
        <span class="lab">{{ copy.compare.eyebrow }}</span>
        <h2 class="serif d2">{{ it.compare.a }}<em>{{ it.compare.b }}</em></h2>
        <p class="p" style="font-size:14.5px">{{ copy.compare.lede }}</p>
      </div>
      <div class="cmp-grid">
        <sc-for list="{{ compare }}" as="r" hint-placeholder-count="3">
          <div style="{{ r.style }}">
            <div role="img" style="display:flex;align-items:center;justify-content:center;gap:var(--s2)" aria-label="{{ r.caps }} capsules per serving">
              <span style="{{ r.pills.0.style }}"><svg width="18" height="46" viewBox="0 0 46 118" aria-hidden="true"><rect x="1" y="1" width="44" height="116" rx="22" fill="currentColor"/><path d="M1 59h44v36a22 22 0 0 1-44 0z" fill="currentColor" opacity=".72"/></svg></span>
              <span style="{{ r.capStyle }}">× {{ r.caps }}</span>
            </div>
            <div style="display:flex;flex-direction:column;gap:6px;padding:var(--s3) 0 var(--s1)">
              <span class="serif" style="{{ r.brandStyle }}">{{ r.brandName }}<sup style="font-size:.32em;vertical-align:super;margin-left:1px;font-family:Inter,sans-serif">{{ r.mark }}</sup></span>
              <span style="font:400 13px/1.4 Inter,sans-serif;opacity:.72">{{ r.maker }}</span>
            </div>
            <span class="lab" style="color:inherit;opacity:.72">{{ r.note }}</span>
          </div>
        </sc-for>
      </div>
      <p class="sm" style="font-size:11.5px;text-align:center;max-width:90ch;margin:0 auto">{{ copy.compare.foot }}</p>
    </div>
  </section>

  <!-- SUPPLEMENT FACTS -->
  <section id="facts" data-screen-label="Supplement Facts" class="sec rule" style="scroll-margin-top:68px">
    <div class="wrap gold" style="align-items:center">
      <figure style="margin:0;display:flex;flex-direction:column;gap:var(--s2)">
        <div style="background:var(--tint);padding:clamp(21px,4vw,55px);display:grid;place-items:center;border-radius:2px">
          <div style="background:#fff;color:#000;border:1px solid #000;padding:clamp(16px,2.4vw,26px);font-family:Helvetica,Arial,sans-serif;max-width:500px;width:100%">
            <div style="font-weight:900;font-size:clamp(26px,3.2vw,36px);line-height:1;letter-spacing:-.01em">Supplement Facts</div>
            <div style="font-weight:700;font-size:14px;line-height:1.35;margin-top:6px">Serving Size {{ copy.facts.servingSize }}<br>Servings Per Container {{ copy.facts.servings }}</div>
            <div style="height:9px;background:#000;margin:9px 0 6px"></div>
            <div style="display:flex;justify-content:space-between;font-weight:800;font-size:13px"><span>Amount Per Capsule</span><span>% Daily Value**</span></div>
            <div style="height:4px;background:#000;margin:6px 0 8px"></div>
            <div style="display:grid;grid-template-columns:1fr auto 24px;gap:8px;font-weight:800;font-size:14px"><span>{{ copy.facts.blendName }}</span><span>{{ copy.facts.blendAmt }}</span><span style="text-align:right">†</span></div>
            <p style="margin:6px 0 0;font-size:13px;line-height:1.45">{{ blendText }}</p>
            <div style="height:9px;background:#000;margin:12px 0 8px"></div>
            <p style="margin:0;font-size:12px;line-height:1.45">{{ dv.0 }}<br>{{ dv.1 }}</p>
            <p style="margin:10px 0 0;font-size:12.5px;line-height:1.45"><strong>Ingredients:</strong> {{ copy.facts.other }}</p>
            <p style="margin:6px 0 0;font-size:12.5px;line-height:1.45"><strong>Allergy Information:</strong> {{ copy.facts.allergy }}</p>
          </div>
        </div>
      </figure>
      <div style="display:flex;flex-direction:column;gap:var(--s3)">
        <span class="lab">{{ copy.facts.eyebrow }}</span>
        <h2 class="serif d2">{{ it.facts.a }}<em>{{ it.facts.b }}</em></h2>
        <p class="p" style="font-size:14.5px">{{ copy.facts.lede }}</p>
        <div style="border-top:1px solid var(--ink)">
          <div style="display:flex;flex-direction:column;gap:6px;padding:var(--s2) 0;border-bottom:1px solid var(--rule)"><span class="lab" style="color:var(--blue)">How to use</span><p class="p" style="font-size:14px">{{ copy.facts.directions }}</p></div>
          <div style="display:flex;flex-direction:column;gap:6px;padding:var(--s2) 0;border-bottom:1px solid var(--rule)"><span class="lab" style="color:var(--blue)">Warning</span><p class="p" style="font-size:14px">{{ warning }}</p></div>
        </div>
      </div>
    </div>
  </section>

  <!-- REVIEWS -->
  <section id="reviews" data-screen-label="Reviews" class="sec rule">
    <div class="wrap" style="display:flex;flex-direction:column;align-items:center;gap:var(--s2);text-align:center">
      <span class="lab">{{ copy.reviews.eyebrow }}</span>
      <p class="serif" style="margin:0;font-size:clamp(68px,9vw,110px);line-height:.9;color:var(--blue)"><em>{{ rating }}</em><span style="font-size:.38em;color:var(--mute)"> / 5</span></p>
      <p class="p" style="max-width:42ch;font-size:14.5px">{{ reviewsLine }}</p>
      <a href="{{ D.reviewsUrl }}" class="btn-line">{{ copy.cta.reviews }} →</a>
      <sc-if value="{{ internal }}" hint-placeholder-val="{{ false }}">
        <div style="width:100%;display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,260px),1fr));gap:var(--s2);margin-top:var(--s3);text-align:left">
          <div style="padding:var(--s3);border:2px dashed var(--gold);font:500 13px/1.5 Inter,sans-serif;color:#5E4710">INTERNAL PLACEHOLDER: approved NZT48 Original review quote 1. Hidden on the live page.</div>
          <div style="padding:var(--s3);border:2px dashed var(--gold);font:500 13px/1.5 Inter,sans-serif;color:#5E4710">INTERNAL PLACEHOLDER: approved NZT48 Original review quote 2. Hidden on the live page.</div>
          <div style="padding:var(--s3);border:2px dashed var(--gold);font:500 13px/1.5 Inter,sans-serif;color:#5E4710">INTERNAL PLACEHOLDER: approved UGC photo or video. Hidden on the live page.</div>
        </div>
      </sc-if>
    </div>
  </section>

  <!-- BUNDLES -->
  <section data-screen-label="Bundles" class="sec" style="background:var(--tint)">
    <div class="wrap" style="display:flex;flex-direction:column;gap:var(--s4)">
      <div style="display:flex;flex-wrap:wrap;justify-content:space-between;align-items:flex-end;gap:var(--s3)">
        <div style="display:flex;flex-direction:column;gap:var(--s1)"><span class="lab">{{ copy.bundles.eyebrow }}</span><h2 class="serif d2">{{ it.bundles.a }}<em>{{ it.bundles.b }}</em></h2><p class="p" style="font-size:14.5px">{{ copy.bundles.lede }}</p></div>
        <div style="display:flex;border:1px solid var(--blue);border-radius:999px;padding:3px;min-width:min(100%,320px)">
          <button type="button" onClick="{{ pickSub }}" aria-pressed="{{ isSub }}" style="{{ segSub }}">{{ copy.buy.sub }}</button>
          <button type="button" onClick="{{ pickOnce }}" aria-pressed="{{ isOnce }}" style="{{ segOnce }}">{{ copy.buy.once }}</button>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,280px),1fr));gap:var(--s3);align-items:stretch">
        <sc-for list="{{ sizes }}" as="s" hint-placeholder-count="3">
          <div onClick="{{ s.pick }}" style="{{ s.tier }}">
            <div style="display:flex;justify-content:space-between;align-items:center;gap:var(--s1)">
              <span class="lab" style="color:inherit;opacity:.75">{{ s.tag }}</span>
              <sc-if value="{{ s.savePct }}"><span class="lab" style="color:inherit">{{ s.savePct }}</span></sc-if>
            </div>
            <div style="aspect-ratio:1/1;border-radius:3px;background:radial-gradient(70% 60% at 50% 55%,rgba(255,255,255,.55),rgba(255,255,255,0) 70%);display:grid;place-items:center"><img src="lx-nzt-photos-size-{{ s.key }}.webp" alt="{{ s.caps }} of NZT48 Original" loading="lazy" style="display:block;width:92%;height:92%;object-fit:contain;filter:drop-shadow(0 24px 22px rgba(28,28,33,.28))"></div>
            <div style="display:flex;justify-content:space-between;align-items:baseline;gap:var(--s2)">
              <h3 class="serif" style="margin:0;font-size:26px;line-height:1.1">{{ s.caps }}</h3>
              <span class="serif" style="font-size:26px;line-height:1">{{ s.total }}</span>
            </div>
            <div style="display:flex;justify-content:space-between;gap:var(--s2);font:400 12.5px/1.5 Inter,sans-serif;opacity:.78">
              <span>{{ s.title }} · {{ s.supply }}<br>{{ s.perCap }}</span>
              <span style="text-align:right"><sc-if value="{{ s.hasStrike }}"><span style="text-decoration:line-through">{{ s.singles }}</span><br></sc-if>{{ s.ship }}</span>
            </div>
            <button type="button" onClick="{{ s.add }}" class="btn-line" style="margin-top:auto;width:100%;min-height:46px;border-color:currentColor;color:inherit">{{ copy.cta.add }}</button>
          </div>
        </sc-for>
      </div>
      <p class="sm" style="font-size:12px">{{ copy.bundles.foot }} {{ disclosure }}</p>
      <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,340px),1fr));gap:var(--s3);padding-top:var(--s4);border-top:1px solid var(--rule)">
        <div style="display:flex;flex-direction:column;gap:var(--s2)">
          <span class="lab" style="color:var(--blue)">{{ copy.buy.sub }}</span>
