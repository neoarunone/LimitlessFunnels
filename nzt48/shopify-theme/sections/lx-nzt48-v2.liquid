{% raw %}



<script src="./lx-nzt-support.js?v=951ae391b8"></script>
<script src="./lx-nzt-version-switch.js?v=c41ec43860"></script>


<x-dc>
<helmet>
<title>NZT48 Original · The Limitless Pill · Limitless X</title>
<meta name="description" content="NZT48 Original: a once-daily nootropic capsule with the 750mg NZT-48 Blend. 30, 60 and 90 capsule options.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&display=swap">
<script src="./lx-nzt-nzt48-shared.js?v=a274babbec"></script>
<style>
/* Golden-ratio system: type 13 / 16 / 26 / 42 / 68 (×1.618) · space 8 / 13 / 21 / 34 / 55 / 89 / 144 · splits 61.8 / 38.2 */
:root{--paper:#FAF6EE;--tint:#F2ECE0;--tint2:#E9E1D2;--ink:#1C1C21;--body:#3D3D44;--mute:#6B6A70;--rule:#E2D9C8;--blue:#26357A;--blue2:#1D2A62;--gold:#A9832A;--gold-ink:#7D5E18;--white:#FFFFFF;
--s1:8px;--s2:13px;--s3:21px;--s4:34px;--s5:55px;--s6:89px;--s7:144px}
html,body{margin:0;background:var(--paper);color:var(--ink);-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility;caret-color:var(--blue);accent-color:var(--blue)}
*{box-sizing:border-box}
::selection{background:var(--blue);color:var(--paper)}
html{scrollbar-color:#CFC4AF var(--paper)}
a{color:var(--blue);text-underline-offset:3px}
a:hover{color:var(--ink)}
button{font-family:inherit}
button:focus-visible,a:focus-visible,summary:focus-visible{outline:2px solid var(--blue);outline-offset:3px;border-radius:6px}
.serif{font-family:"Instrument Serif",Georgia,serif;font-weight:400;letter-spacing:-.01em;text-wrap:balance}
.serif em,.it{font-style:italic}
.d1{margin:0;font-size:clamp(42px,5.2vw,68px);line-height:1.04;color:var(--blue)}
.d2{margin:0;font-size:clamp(32px,3.4vw,42px);line-height:1.1;color:var(--blue)}
.d3{margin:0;font-size:26px;line-height:1.15;color:var(--blue)}
.p{margin:0;font:400 16px/1.62 Inter,Arial,sans-serif;color:var(--body);text-wrap:pretty}
.sm{margin:0;font:400 13px/1.6 Inter,Arial,sans-serif;color:var(--mute);text-wrap:pretty}
.lab{font:600 11px/1.2 Inter,Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase;color:var(--mute)}
.wrap{max-width:1180px;margin:0 auto;padding:0 clamp(16px,3vw,34px)}
.sec{padding:var(--s6) 0}
.rule{border-top:1px solid var(--rule)}
.gold{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,300px),1fr));gap:var(--s5)}
@media (min-width:900px){.gold{grid-template-columns:minmax(0,1.618fr) minmax(0,1fr)}.gold-r{grid-template-columns:minmax(0,1fr) minmax(0,1.618fr)}.stick{position:sticky;top:89px}}

.btn{display:inline-flex;align-items:center;justify-content:center;gap:var(--s1);min-height:52px;padding:0 var(--s4);border:0;border-radius:999px;background:var(--blue);color:var(--paper);cursor:pointer;text-decoration:none;font:600 15px/1 Inter,Arial,sans-serif;transition:background .2s}
.btn:hover{background:var(--blue2);color:var(--paper)}
.btn-line{display:inline-flex;align-items:center;justify-content:center;gap:6px;min-height:44px;padding:0 var(--s3);border-radius:999px;border:1px solid var(--blue);color:var(--blue);background:transparent;text-decoration:none;cursor:pointer;font:600 11px/1 Inter,Arial,sans-serif;letter-spacing:.14em;text-transform:uppercase;transition:background .2s,color .2s}
.btn-line:hover{background:var(--blue);color:var(--paper)}
.hd-cta{white-space:nowrap}
@media (max-width:399px){.hd-cta{padding:0 var(--s2);letter-spacing:.1em}.hd-logo{height:15px !important}}
@media (max-width:600px){.annc{column-gap:var(--s2) !important;letter-spacing:.08em;font-size:10px}}
.navl{display:inline-flex;align-items:center;min-height:44px}
.acc{border-bottom:1px solid var(--rule)}
.acc summary{list-style:none;cursor:pointer;display:grid;grid-template-columns:34px minmax(0,1fr) 28px;gap:var(--s2);align-items:baseline;padding:var(--s3) 0}
.acc summary::-webkit-details-marker{display:none}
.acc .pm{font:400 22px/1 Inter,sans-serif;color:var(--blue);transition:transform .3s cubic-bezier(.16,1,.3,1);justify-self:end}
.acc[open] .pm{transform:rotate(45deg)}
.row{display:flex;gap:var(--s3);overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:var(--s3);scrollbar-width:thin;scrollbar-color:var(--blue) var(--rule)}
.row::-webkit-scrollbar{height:3px}.row::-webkit-scrollbar-track{background:var(--rule)}.row::-webkit-scrollbar-thumb{background:var(--blue)}
.cols2{columns:2 280px;column-gap:var(--s4)}
.cols2 p+p{margin-top:var(--s2)}
/* Hero slider */
.hero-grid{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--s4);align-items:start}
@media (min-width:900px){.hero-grid{grid-template-columns:minmax(0,.92fr) minmax(0,1fr);gap:var(--s5)}}
.hs{position:relative;aspect-ratio:4/5;max-height:calc(100svh - 200px);width:100%;border-radius:4px;overflow:hidden;background:var(--tint)}
.hs-slide{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0;transform:scale(1.045);transition:opacity 1s cubic-bezier(.16,1,.3,1),transform 6.5s linear}
.hs:not([data-ready]) .hs-slide:first-of-type,.hs-slide[data-on]{opacity:1;transform:scale(1)}
.hs-nav{position:absolute;left:var(--s3);right:var(--s3);bottom:var(--s3);display:flex;align-items:center;justify-content:space-between;gap:var(--s2);z-index:2}
.hs-dots{display:flex}
.hs-dots button{position:relative;width:24px;height:24px;border:0;padding:0;background:none;cursor:pointer;transition:width .3s}
.hs-dots button::before{content:"";position:absolute;left:4px;right:4px;top:50%;height:3px;margin-top:-1.5px;border-radius:2px;background:rgba(250,246,238,.4);transition:background .3s}
.hs-dots button[data-on]{width:40px}.hs-dots button[data-on]::before{background:var(--paper)}
@media (max-width:420px){.hs-nav{left:var(--s2);right:var(--s2);bottom:var(--s2)}}
.hs-arrows{display:flex;gap:8px}
.hs-arrows button{width:44px;height:44px;border-radius:50%;border:1px solid rgba(250,246,238,.6);background:rgba(28,28,33,.25);color:var(--paper);cursor:pointer;display:grid;place-items:center;backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}
.hs-arrows button:hover{background:var(--paper);color:var(--blue)}
/* Ingredient photography in the formula index */
#formula .acc summary{grid-template-columns:96px minmax(0,1fr) 28px;align-items:center;gap:var(--s3);padding:var(--s2) 0}
.ing-photo{display:block;width:96px;height:96px;object-fit:cover;border-radius:3px;background:var(--tint)}
.ing-research{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,220px),1fr));gap:var(--s2) var(--s4);padding:0 0 var(--s3) 117px}
@media(max-width:600px){#formula .acc summary{grid-template-columns:72px minmax(0,1fr) 20px;gap:var(--s2)}.ing-photo{width:72px;height:72px}.ing-research{padding-left:0}}
/* Hero helpers */
.desk-only{display:none}
@media (min-width:900px){.desk-only{display:block}.mob-only{display:none}}
/* Trust marquee */
.tm{overflow:hidden;border-top:1px solid var(--rule);border-bottom:1px solid var(--rule);-webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent);mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent)}
.tm-track{display:flex;width:max-content;animation:tm 38s linear infinite}
.tm:hover .tm-track{animation-play-state:paused}
.tm-item{display:flex;align-items:center;gap:var(--s2);padding:var(--s3) var(--s4);font:500 14px/1 Inter,sans-serif;color:var(--ink);white-space:nowrap}
.tm-item svg{color:var(--blue)}
@keyframes tm{to{transform:translateX(-50%)}}
/* Benefit image tiles */
.btile{position:relative;aspect-ratio:4/5;border-radius:3px;overflow:hidden;background:var(--tint)}
.btile img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .9s cubic-bezier(.16,1,.3,1)}
.btile::after{content:"";position:absolute;inset:0;background:var(--blue);opacity:0;transition:opacity .45s cubic-bezier(.16,1,.3,1)}
.bcard:hover .btile::after,.bcard:focus-within .btile::after{opacity:.5}
.bcard:hover .btile img{transform:scale(1.04)}
/* Scenario cards */
.scard img{display:block;width:100%;aspect-ratio:4/5;object-fit:cover;border-radius:3px;filter:saturate(.9)}
/* Footer */
.ft a{color:#DADEEC;text-decoration:none}.ft a:hover{color:#fff}
.ft-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--s5) var(--s4);align-items:start}.ft-grid>:first-child{grid-column:1/-1}
@media (min-width:900px){.ft-grid{grid-template-columns:2fr 1fr 1fr 1fr}.ft-grid>:first-child{grid-column:auto}}
.ft-col{display:flex;flex-direction:column;gap:0}
.ft-col>.lab{margin-bottom:var(--s1)}
.ft-col a{display:inline-flex;align-items:center;gap:10px;min-height:44px;font:400 14px/1.4 Inter,sans-serif}
@media (max-width:899px){.ft{padding-bottom:calc(69px + env(safe-area-inset-bottom))}}
.ft-col a svg{color:#FAD346;opacity:.8;transition:transform .25s cubic-bezier(.16,1,.3,1),opacity .2s}
.ft-col a:hover svg{opacity:1;transform:translateX(2px)}
/* Capsule comparison */
.cmp-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr));gap:var(--s2)}
@keyframes spin{to{transform:rotate(360deg)}}
@keyframes lxin{from{transform:translateY(13px)}to{transform:none}}
.rise{animation:lxin 1.2s cubic-bezier(.16,1,.3,1) both}
@media (prefers-reduced-motion: reduce){*{animation:none !important;transition:none !important;scroll-behavior:auto !important}
.tm{-webkit-mask-image:none;mask-image:none}.tm-track{width:auto;flex-wrap:wrap;justify-content:center;padding:var(--s1) 0}.tm-item{padding:var(--s1) var(--s3)}.tm-item[aria-hidden]{display:none}}
</style>
</helmet>

<div style="min-height:100vh;background:var(--paper);font-family:Inter,Arial,sans-serif;overflow-x:clip">

  <div style="border-bottom:1px solid var(--rule)">
    <div class="wrap lab annc" style="padding-top:10px;padding-bottom:10px;display:flex;flex-wrap:wrap;justify-content:center;gap:6px 34px;text-align:center;color:var(--body)">
      <sc-for list="{{ copy.announce }}" as="a" hint-placeholder-count="4"><span>{{ a }}</span></sc-for>
    </div>
  </div>

  <header style="position:sticky;top:0;z-index:40;background:var(--paper);border-bottom:1px solid var(--rule)">
    <div class="wrap" style="height:68px;display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:var(--s2)">
      <nav style="display:flex;gap:var(--s4);align-items:center">
        <sc-if value="{{ wide }}" hint-placeholder-val="{{ true }}">
          <a href="#formula" class="lab navl" style="color:var(--ink);text-decoration:none">Formula</a>
          <a href="#facts" class="lab navl" style="color:var(--ink);text-decoration:none">Label</a>
          <a href="#faq" class="lab navl" style="color:var(--ink);text-decoration:none">FAQ</a>
        </sc-if>
      </nav>
      <img class="hd-logo" src="lx-nzt-logo-limitlessx.svg?v=002381cf37" alt="Limitless X" style="height:19px;width:auto">
      <a href="#buy" class="btn-line hd-cta" style="justify-self:end">{{ copy.cta.shop }}</a>
    </div>
  </header>

  <!-- HERO -->
  <section data-screen-label="Hero" style="padding:var(--s3) 0 var(--s6)">
    <div class="wrap" style="display:flex;flex-direction:column;gap:var(--s5)">
      <div id="buy" class="hero-grid" style="scroll-margin-top:89px">
        <div class="stick" style="display:flex;flex-direction:column;gap:var(--s3)">
        <div class="hs" id="hs" aria-roledescription="carousel" aria-label="NZT48 Original photos">
          <img class="hs-slide" src="lx-nzt-photos-hero-a.webp?v=e94954d67b" alt="Woman holding a bottle of NZT48 Original in a bright white setting" fetchpriority="high">
          <img class="hs-slide" src="lx-nzt-photos-bottle-motion.webp?v=574696b6a0" alt="NZT48 Original bottle in motion on an orange backdrop" loading="lazy">
          <img class="hs-slide" src="lx-nzt-photos-hero-b.webp?v=6170b816b6" alt="Hand presenting a bottle of NZT48 Original on a soft pink backdrop" loading="lazy">
          <img class="hs-slide" src="lx-nzt-photos-hero-c.webp?v=235eef2fae" alt="Two bottles of NZT48 Original on a stone tray" loading="lazy">
          <img class="hs-slide" src="lx-nzt-photos-hero-d.webp?v=033bb85176" alt="Open bottle of NZT48 Original with its gold cap" loading="lazy">
          <div class="hs-nav">
            <div class="hs-dots"><button type="button" aria-label="Photo 1"></button><button type="button" aria-label="Photo 2"></button><button type="button" aria-label="Photo 3"></button><button type="button" aria-label="Photo 4"></button><button type="button" aria-label="Photo 5"></button></div>
            <div class="hs-arrows"><button type="button" data-dir="-1" aria-label="Previous photo"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round"><path d="M15 6l-6 6 6 6"/></svg></button><button type="button" data-dir="1" aria-label="Next photo"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round"><path d="M9 6l6 6-6 6"/></svg></button></div>
          </div>
        </div>
        <p class="p desk-only" style="font-size:15px;max-width:62ch">{{ copy.hero.body }}</p>
        </div>

        <div style="display:flex;flex-direction:column;gap:var(--s3);min-width:0">
          <div style="display:flex;flex-direction:column;gap:var(--s2)">
            <span class="lab" style="text-wrap:balance">{{ copy.hero.eyebrow }}</span>
            <h1 class="serif" style="margin:0;font-size:clamp(34px,3.4vw,48px);line-height:1.06;color:var(--blue)">{{ copy.hero.h1 }} <em>{{ it.heroSupport.a }}</em>{{ it.heroSupport.b }}</h1>
          <a href="#reviews" style="display:inline-flex;align-self:flex-start;align-items:center;min-height:44px;gap:var(--s1);text-decoration:none;color:var(--body);font:500 13px/1 Inter,sans-serif">
            <svg width="76" height="13" viewBox="0 0 92 16" aria-hidden="true"><g fill="#A9832A"><path d="M8 0l2.4 5.2 5.6.6-4.2 3.8 1.2 5.5L8 12.3 3 15.1l1.2-5.5L0 5.8l5.6-.6z"/><path transform="translate(19 0)" d="M8 0l2.4 5.2 5.6.6-4.2 3.8 1.2 5.5L8 12.3 3 15.1l1.2-5.5L0 5.8l5.6-.6z"/><path transform="translate(38 0)" d="M8 0l2.4 5.2 5.6.6-4.2 3.8 1.2 5.5L8 12.3 3 15.1l1.2-5.5L0 5.8l5.6-.6z"/><path transform="translate(57 0)" d="M8 0l2.4 5.2 5.6.6-4.2 3.8 1.2 5.5L8 12.3 3 15.1l1.2-5.5L0 5.8l5.6-.6z"/><path transform="translate(76 0)" d="M8 0l2.4 5.2 5.6.6-4.2 3.8 1.2 5.5L8 12.3 3 15.1l1.2-5.5L0 5.8l5.6-.6z"/></g></svg>
            <span><strong style="color:var(--ink);font-weight:600">{{ rating }}</strong> from {{ reviewCount }} reviews</span>
          </a>
            <p class="p mob-only" style="font-size:15px">{{ copy.hero.body }}</p>
          </div>
          <span class="lab">{{ copy.buy.h }}</span>
          <div style="display:flex;border:1px solid var(--blue);border-radius:999px;padding:3px">
            <button type="button" onClick="{{ pickSub }}" aria-pressed="{{ isSub }}" style="{{ segSub }}">{{ copy.buy.sub }}</button>
            <button type="button" onClick="{{ pickOnce }}" aria-pressed="{{ isOnce }}" style="{{ segOnce }}">{{ copy.buy.once }}</button>
          </div>

          <div role="radiogroup" aria-label="Package size" style="display:flex;flex-direction:column;border-top:1px solid var(--ink)">
            <sc-for list="{{ sizes }}" as="s" hint-placeholder-count="3">
              <button type="button" role="radio" aria-checked="{{ s.sel }}" onClick="{{ s.pick }}" style="{{ s.style }}">
                <span style="{{ s.dot }}"></span>
                <span style="display:flex;flex-direction:column;gap:5px;min-width:0;flex:1;text-align:left">
                  <span style="display:flex;flex-wrap:wrap;align-items:baseline;gap:var(--s1)"><span class="serif" style="font-size:22px;line-height:1;color:var(--ink)">{{ s.caps }}</span><span class="lab" style="color:var(--gold-ink);font-size:10.5px">{{ s.tag }}</span></span>
                  <span style="font:400 12.5px/1.3 Inter,sans-serif;color:var(--mute)">{{ s.supply }} · {{ s.perCap }}</span>
                </span>
                <span style="display:flex;flex-direction:column;align-items:flex-end;gap:5px">
                  <span style="font:600 16px/1 Inter,sans-serif;color:var(--ink);font-variant-numeric:tabular-nums">{{ s.total }}</span>
                  <sc-if value="{{ s.hasStrike }}"><span style="font:400 12px/1 Inter,sans-serif;color:var(--mute);text-decoration:line-through">{{ s.singles }}</span></sc-if>
                </span>
              </button>
            </sc-for>
          </div>

          <sc-if value="{{ isSub }}" hint-placeholder-val="{{ true }}">
            <div style="display:flex;flex-direction:column;gap:var(--s1)">
              <span class="lab">{{ copy.buy.every }}</span>
              <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,140px),1fr));gap:var(--s1)">
                <sc-for list="{{ freqs }}" as="f" hint-placeholder-count="4">
                  <button type="button" onClick="{{ f.pick }}" style="{{ f.style }}"><span>{{ f.label }}</span><span style="font:600 11px/1 Inter,sans-serif;letter-spacing:.06em;color:var(--gold-ink)">{{ f.off }}</span></button>
                </sc-for>
              </div>
            </div>
          </sc-if>

          <div style="display:flex;align-items:baseline;justify-content:space-between;gap:var(--s2);flex-wrap:wrap;padding-top:var(--s2);border-top:1px solid var(--rule)">
            <span style="font:400 13px/1.3 Inter,sans-serif;color:var(--mute)">{{ sel.caps }} · {{ sel.perCap }} per capsule</span>
            <span style="display:flex;align-items:baseline;gap:var(--s1)"><sc-if value="{{ sel.hasStrike }}"><span style="font:400 14px/1 Inter,sans-serif;color:var(--mute);text-decoration:line-through">{{ sel.singles }}</span></sc-if><span class="serif" style="font-size:42px;line-height:.9;color:var(--ink)">{{ sel.total }}</span></span>
          </div>
          <button type="button" class="btn" onClick="{{ addToCart }}" style="width:100%;min-height:55px">{{ cta }}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg></button>
          <p class="sm" style="font-size:12px">{{ disclosure }}</p>
          <div style="display:flex;flex-direction:column;gap:6px">
            <div style="height:3px;background:var(--rule)"><div style="{{ shipBar }}"></div></div>
            <sc-if value="{{ shipOn }}"><span style="font:500 12.5px/1.3 Inter,sans-serif;color:var(--ink)">{{ copy.buy.shipOn }}</span></sc-if>
            <sc-if value="{{ shipOff }}"><span style="font:400 12.5px/1.3 Inter,sans-serif;color:var(--mute)">{{ shipAwayLine }}</span></sc-if>
          </div>
          <p class="sm" style="font-size:12px;padding-top:var(--s2);border-top:1px solid var(--rule)">{{ copy.hero.note }}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- TRUST: scrolling marquee, Lucide icons -->
  <section data-screen-label="Trust" aria-label="Product standards">
